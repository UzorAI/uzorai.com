# Scaffold build artifacts (REFACTOR #15 Phase 1).
# Kept out of git so the production deploy (git archive HEAD -> Pages static
# upload, see .github/workflows/deploy.yml) never ships node_modules or dist.
node_modules/
dist/
.wrangler/
*.log

# OS metadata — never track editor/OS noise files.
*:Zone.Identifier
.DS_Store
Thumbs.db

# Environment / secrets — never commit; .env.example is the tracked template
# and must stay excluded from every pattern below.
.env
.env.*
!.env.example
.dev.vars*
*.pem
*.key
*.p12
*.crt
*.pfx
*credentials*.json
.secrets/

# Runtime state / local databases
*.sqlite
*.sqlite3
*.db

# Claude Code local overrides and agent scratch/temp files — machine-specific,
# never shared via git.
.claude/settings.local.json
.claude/tmp/
*.tmp

# Browser verification output (published as CI artifacts).
test-results/
playwright-report/
