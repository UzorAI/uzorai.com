# Scaffold build artifacts (REFACTOR #15 Phase 1).
# Kept out of git so the production deploy (git archive HEAD -> Pages static
# upload, see .github/workflows/deploy.yml) never ships node_modules or dist.
node_modules/
dist/
.wrangler/
*.log

# Windows / WSL "mark of the web" metadata — rides along on /mnt/c copies; never track.
*:Zone.Identifier

# Environment / secrets (REFACTOR #83) — never commit; .env.example is the
# tracked template and must stay excluded from every pattern below.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*.json
.secrets/

# Runtime state / local databases
*.sqlite
*.sqlite3
*.db

# Generated report from scripts/security/run-dependency-audit.mjs (CHORE
# #84) — a point-in-time npm audit record, not a tracked artifact.
security-audit-report.json

# Claude Code local overrides and agent scratch/temp files — machine-specific,
# never shared via git.
.claude/settings.local.json
.claude/tmp/
*.tmp
